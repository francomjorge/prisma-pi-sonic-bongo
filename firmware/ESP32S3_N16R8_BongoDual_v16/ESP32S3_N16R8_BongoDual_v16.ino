<header><div><h1>SONIC BONGO · CONTINUOUS FUNCTION v16</h1><div class="sub">Calibración física + función Y(t) / V(t) / A(t) para detectar gesto, intensidad y golpes continuos</div></div><div><span id="runPill" class="pill">...</span> <span id="cfgPill" class="pill">...</span></div></header><div class="wrap"><div class="tabs"><button id="btnCal" class="tabBtn active" onclick="showTab('cal')">CALIBRACIÓN</button><button id="btnFunc" class="tabBtn" onclick="showTab('func')">FUNCIÓN</button></div>
<div id="tabCal" class="tab active"><div class="cards"><div class="card"><div class="k">S1 STABLE</div><div id="d1" class="v s1">--</div></div><div class="card"><div class="k">S2 STABLE</div><div id="d2" class="v s2">--</div></div><div class="card"><div class="k">PUNTO Y</div><div id="yPoint" class="v">--</div></div><div class="card"><div class="k">FUENTE</div><div id="source" class="v">--</div></div><div class="card"><div class="k">POINT Hz</div><div id="pointHz" class="v">--</div></div><div class="card"><div class="k">JITTER</div><div id="jitter" class="v">--</div></div></div><div class="main"><section class="panel"><div class="row"><span class="section">ARCOS + PUNTO CENTRAL</span><b id="calZone">--</b></div><canvas id="geo" width="860" height="570"></canvas><div class="note">La línea HIT queda como referencia de calibración. La pestaña FUNCIÓN no depende de cruzarla.</div></section><section class="panel"><div class="section">TELEMETRÍA</div><div class="metricGrid" style="margin-top:8px"><div class="metric"><span>Edad S1 / S2</span><b id="ages">--</b></div><div class="metric"><span>Hz S1 / S2</span><b id="sensorHz">--</b></div><div class="metric"><span>RAW S1 / S2</span><b id="raw">--</b></div><div class="metric"><span>Timeouts</span><b id="timeouts">--</b></div><div class="metric"><span>Coherencia</span><b id="coh">--</b></div><div class="metric"><span>X diagnóstico</span><b id="xdiag">--</b></div></div></section></div><section class="panel" style="margin-top:8px"><div class="section">GEOMETRÍA</div><div class="controls"><div class="ctrl"><div class="ctrlHead"><span>Distancia sensores</span><b><span id="baselineV">1.0</span> cm</b></div><input id="baseline" type="range" min=".5" max="10" step=".1" value="1"></div><div class="ctrl"><div class="ctrlHead"><span>Plano HIT referencia</span><b><span id="hitPlaneV">12</span> cm</b></div><input id="hitPlane" type="range" min="5" max="30" step=".5" value="12"></div><div class="ctrl"><div class="ctrlHead"><span>Semiángulo</span><b><span id="angleV">7.5</span>°</b></div><input id="angle" type="range" min="3" max="20" step=".5" value="7.5"></div></div></section><section class="panel" style="margin-top:8px"><div class="section">ADQUISICIÓN</div><div class="controls"><div class="ctrl"><div class="ctrlHead"><span>Rango máximo</span><b><span id="rangeV">50</span> cm</b></div><input id="range" type="range" min="20" max="100" step="5" value="50"></div><div class="ctrl"><div class="ctrlHead"><span>Objetivo por sensor</span><b><span id="rateV">16</span> Hz</b></div><input id="rate" type="range" min="5" max="16" step="1" value="16"></div><div class="ctrl"><div class="ctrlHead"><span>Estabilidad</span><b><span id="smoothV">55</span>%</b></div><input id="smooth" type="range" min="0" max="100" step="5" value="55"></div></div></section></div>
<div id="tabFunc" class="tab"><div class="cards"><div class="card"><div class="k">Y(t)</div><div id="fY" class="v">--</div></div><div class="card"><div class="k">VELOCIDAD</div><div id="fV" class="v">--</div></div><div class="card"><div class="k">ACELERACIÓN</div><div id="fA" class="v">--</div></div><div class="card"><div class="k">FASE</div><div id="phase" class="v violet">--</div></div><div class="card"><div class="k">CANDIDATOS</div><div id="candCount" class="v accent">0</div></div><div class="card"><div class="k">ROLL</div><div id="roll" class="v">--</div></div></div><section class="panel" style="margin-top:8px"><div class="row"><span class="section">FUNCIÓN DE ALTURA Y(t)</span><span class="note">mínimos confirmados = candidatos de golpe</span></div><canvas id="waveY" width="1200" height="300"></canvas></section><div class="blocks"><section class="panel"><div class="row"><span class="section">VELOCIDAD V(t)</span><b id="downInfo">--</b></div><canvas id="waveV" width="700" height="230"></canvas></section><section class="panel"><div class="row"><span class="section">ACELERACIÓN A(t)</span><b id="accInfo">--</b></div><canvas id="waveA" width="700" height="230"></canvas></section></div><div class="blocks"><section class="panel"><div class="section">ANÁLISIS DEL GESTO</div><div class="metricGrid" style="margin-top:8px"><div class="metric"><span>Score candidato</span><b id="scoreText">--</b></div><div class="metric"><span>Última amplitud</span><b id="lastAmp">--</b></div><div class="metric"><span>Pico descenso</span><b id="lastSpeed">--</b></div><div class="metric"><span>Intensidad MIDI</span><b id="midi">--</b></div><div class="metric"><span>Período</span><b id="period">--</b></div><div class="metric"><span>Frecuencia roll</span><b id="rollHz">--</b></div></div><div class="row"><span>Progreso candidato</span><b id="scoreLabel">0%</b></div><div class="score"><i id="scoreBar"></i></div></section><section class="panel"><div class="section">DETECTOR DE FUNCIÓN</div><div class="controls" style="grid-template-columns:1fr 1fr"><div class="ctrl"><div class="ctrlHead"><span>Descenso mínimo</span><b><span id="fSpeedV">45</span> cm/s</b></div><input id="fSpeed" type="range" min="10" max="250" step="5" value="45"></div><div class="ctrl"><div class="ctrlHead"><span>Amplitud mínima</span><b><span id="fAmpV">2.0</span> cm</b></div><input id="fAmp" type="range" min=".4" max="10" step=".2" value="2"></div><div class="ctrl"><div class="ctrlHead"><span>Velocidad de rebote</span><b><span id="fRevV">8</span> cm/s</b></div><input id="fRev" type="range" min="1" max="60" step="1" value="8"></div><div class="ctrl"><div class="ctrlHead"><span>Gap máx. roll</span><b><span id="fRollGapV">340</span> ms</b></div><input id="fRollGap" type="range" min="120" max="900" step="20" value="340"></div><div class="ctrl"><div class="ctrlHead"><span>Intervalo mínimo</span><b><span id="fMinIntV">70</span> ms</b></div><input id="fMinInt" type="range" min="40" max="300" step="10" value="70"></div><div class="ctrl"><div class="ctrlHead"><span>Referencia intensidad</span><b><span id="speedV">35</span> cm/s</b></div><input id="speed" type="range" min="10" max="180" step="5" value="35"></div></div></section></div></div>
<section class="panel" style="margin-top:8px"><div class="buttons"><button class="danger" onclick="setRun(false)">DETENER</button><button class="primary" onclick="setRun(true)">INICIAR</button><button class="primary" onclick="saveConfig()">GUARDAR Y APLICAR</button><button onclick="loadCurrent()">CARGAR ACTUALES</button><button onclick="resetEvents()">RESET EVENTOS</button><button id="soundBtn" class="blue" onclick="toggleSound()">SONIDO OFF</button><button onclick="testSound()">PROBAR SONIDO</button></div><div id="status" class="status"></div></section></div>
<script>
const $=id=>document.getElementById(id),G=$('geo').getContext('2d'),Y=$('waveY').getContext('2d'),V=$('waveV').getContext('2d'),A=$('waveA').getContext('2d');const ids=['baseline','hitPlane','angle','range','rate','smooth','speed','fSpeed','fAmp','fRev','fRollGap','fMinInt'];const labels={baseline:'baselineV',hitPlane:'hitPlaneV',angle:'angleV',range:'rangeV',rate:'rateV',smooth:'smoothV',speed:'speedV',fSpeed:'fSpeedV',fAmp:'fAmpV',fRev:'fRevV',fRollGap:'fRollGapV',fMinInt:'fMinIntV'};let first=true,dirty=false,lastData=null,lastEvent=null,soundOn=false,audioCtx=null,activeTab='cal';const samples=[],trail=[];
function showTab(t){activeTab=t;$('tabCal').className='tab '+(t==='cal'?'active':'');$('tabFunc').className='tab '+(t==='func'?'active':'');$('btnCal').className='tabBtn '+(t==='cal'?'active':'');$('btnFunc').className='tabBtn '+(t==='func'?'active':'');if(lastData)drawAll(lastData);}ids.forEach(id=>$(id).addEventListener('input',()=>{$(labels[id]).textContent=$(id).value;dirty=true;setCfgState();if(lastData)drawAll(lastData);}));function setCfgState(){$('cfgPill').textContent=dirty?'CAMBIOS PENDIENTES':'CONFIG GUARDADA';$('cfgPill').className='pill '+(dirty?'pending':'on');}function localCfg(){return{baseline:+$('baseline').value,hit:+$('hitPlane').value,angle:+$('angle').value,range:+$('range').value,rate:+$('rate').value,smooth:+$('smooth').value,speed:+$('speed').value,fSpeed:+$('fSpeed').value,fAmp:+$('fAmp').value,fRev:+$('fRev').value,fRollGap:+$('fRollGap').value,fMinInt:+$('fMinInt').value};}function syncCfg(c){const m={baseline:c.baseline,hitPlane:c.hitPlane,angle:c.coneHalfAngle,range:c.maxRange,rate:c.targetHz,smooth:c.smoothing,speed:c.intensityRef,fSpeed:c.funcMinDownSpeed,fAmp:c.funcMinAmplitude,fRev:c.funcReversalSpeed,fRollGap:c.funcRollMaxGap,fMinInt:c.funcMinInterval};Object.entries(m).forEach(([id,v])=>{if($(id)){$(id).value=v;$(labels[id]).textContent=v}});dirty=false;setCfgState();}function line(c,x1,y1,x2,y2,col='#2b3f4d',w=1){c.beginPath();c.moveTo(x1,y1);c.lineTo(x2,y2);c.strokeStyle=col;c.lineWidth=w;c.stroke();}function text(c,s,x,y,col='#8094a5',sz=10,a='left'){c.fillStyle=col;c.font=sz+'px system-ui';c.textAlign=a;c.fillText(s,x,y);}function arc(c,x,y,r,col,w=1,alpha=1){c.save();c.globalAlpha=alpha;c.beginPath();c.arc(x,y,r,Math.PI,Math.PI*2);c.strokeStyle=col;c.lineWidth=w;c.stroke();c.restore();}
function drawCalibration(j){const c=localCfg(),W=860,H=570,baseY=520,cx=W/2,max=c.range,sc=(H-92)/max;G.clearRect(0,0,W,H);for(let q=5;q<=max;q+=5){const yy=baseY-q*sc;line(G,48,yy,W-24,yy,q%10===0?'#19303d':'#10212b');if(q%10===0)text(G,q+' cm',8,yy+3,'#60798a',10)}line(G,cx,34,cx,baseY,'#1b3340');const sx1=cx-c.baseline*.5*sc,sx2=cx+c.baseline*.5*sc,hy=baseY-c.hit*sc;line(G,46,hy,W-24,hy,'#ffc85e',2);text(G,'REFERENCIA '+c.hit.toFixed(1)+' cm',W-28,hy-7,'#ffc85e',11,'right');const len=max*sc,spread=Math.tan(c.angle*Math.PI/180)*len;[[sx1,'#58e8cd'],[sx2,'#76a0ff']].forEach(v=>{G.save();G.globalAlpha=.06;G.beginPath();G.moveTo(v[0],baseY);G.lineTo(v[0]-spread,baseY-len);G.lineTo(v[0]+spread,baseY-len);G.closePath();G.fillStyle=v[1];G.fill();G.restore();line(G,v[0],baseY,v[0]-spread,baseY-len,v[1]);line(G,v[0],baseY,v[0]+spread,baseY-len,v[1]);});G.fillStyle='#58e8cd';G.fillRect(sx1-9,baseY-7,18,14);G.fillStyle='#76a0ff';G.fillRect(sx2-9,baseY-7,18,14);text(G,'S1',sx1,baseY+27,'#58e8cd',11,'center');text(G,'S2',sx2,baseY+27,'#76a0ff',11,'center');if(j.s1.fresh)arc(G,sx1,baseY,j.s1.stable*sc,'#58e8cd',2.2,.88);if(j.s2.fresh)arc(G,sx2,baseY,j.s2.stable*sc,'#76a0ff',2.2,.88);if(j.pair.valid){const py=baseY-j.pair.yPoint*sc;trail.push(py);if(trail.length>12)trail.shift();trail.forEach((yy,i)=>{G.save();G.globalAlpha=(i+1)/trail.length*.14;G.beginPath();G.arc(cx,yy,3,0,Math.PI*2);G.fillStyle='#fff';G.fill();G.restore();});G.beginPath();G.arc(cx,py,9,0,Math.PI*2);G.fillStyle='#fff';G.fill();text(G,j.pair.yPoint.toFixed(2)+' cm',cx+15,py-10,'#fff',12);$('calZone').textContent=j.pair.yPoint<=c.hit?'BAJO REFERENCIA':'SOBRE REFERENCIA';}else $('calZone').textContent='SIN SEÑAL';}
function plotSeries(ctx,arr,key,min,max,zero,threshold){const W=ctx.canvas.width,H=ctx.canvas.height,p=34;ctx.clearRect(0,0,W,H);const span=Math.max(.001,max-min),yy=v=>H-p-(v-min)/span*(H-2*p);for(let i=0;i<=4;i++){const v=min+span*i/4;line(ctx,p,yy(v),W-8,yy(v),'#13242e');text(ctx,v.toFixed(Math.abs(v)<10?1:0),4,yy(v)+3,'#60798a',9);}if(zero!==null&&zero>=min&&zero<=max)line(ctx,p,yy(zero),W-8,yy(zero),'#405566',1.2);if(threshold!==null&&threshold>=min&&threshold<=max)line(ctx,p,yy(threshold),W-8,yy(threshold),'#ffc85e',1.2);ctx.beginPath();let st=false;arr.forEach((r,i)=>{const v=r[key];if(!Number.isFinite(v)){st=false;return}const x=p+i/Math.max(1,arr.length-1)*(W-p-12);if(!st){ctx.moveTo(x,yy(v));st=true}else ctx.lineTo(x,yy(v));});ctx.strokeStyle=key==='y'?'#ffffff':key==='v'?'#58e8cd':'#be8cff';ctx.lineWidth=2;ctx.stroke();}
function drawFunction(j){const c=localCfg(),maxY=c.range;plotSeries(Y,samples,'y',0,maxY,null,null);const W=Y.canvas.width,H=Y.canvas.height,p=34,yy=v=>H-p-v/maxY*(H-2*p);samples.forEach((r,i)=>{if(r.event){const x=p+i/Math.max(1,samples.length-1)*(W-p-12);Y.beginPath();Y.arc(x,yy(r.y),5,0,Math.PI*2);Y.fillStyle='#ffc85e';Y.fill();}});const vmax=Math.max(120,c.fSpeed*2.5);plotSeries(V,samples,'v',-vmax,vmax,0,-c.fSpeed);plotSeries(A,samples,'a',-3500,3500,0,null);}function drawAll(j){if(activeTab==='cal')drawCalibration(j);else drawFunction(j);}
async function ensureAudio(){if(!audioCtx)audioCtx=new(window.AudioContext||window.webkitAudioContext)();await audioCtx.resume();}function playEvent(m=80){if(!soundOn||!audioCtx)return;const n=audioCtx.currentTime,o=audioCtx.createOscillator(),g=audioCtx.createGain();o.type='triangle';o.frequency.value=420+Math.min(127,m)*4;g.gain.setValueAtTime(.0001,n);g.gain.exponentialRampToValueAtTime(.18,n+.003);g.gain.exponentialRampToValueAtTime(.0001,n+.065);o.connect(g);g.connect(audioCtx.destination);o.start(n);o.stop(n+.075);}async function toggleSound(){await ensureAudio();soundOn=!soundOn;$('soundBtn').textContent=soundOn?'SONIDO ON':'SONIDO OFF';if(soundOn)playEvent(55);}async function testSound(){await ensureAudio();soundOn=true;$('soundBtn').textContent='SONIDO ON';playEvent(95);}async function setRun(on){await fetch('/api/run?on='+(on?1:0),{cache:'no-store'});await refresh();}async function resetEvents(){await fetch('/api/reset',{cache:'no-store'});lastEvent=null;samples.length=0;await refresh();}
async function saveConfig(){const c=localCfg(),q=new URLSearchParams({base:c.baseline,hit:c.hit,angle:c.angle,range:c.range,rate:c.rate,smooth:c.smooth,speed:c.speed,fSpeed:c.fSpeed,fAmp:c.fAmp,fRev:c.fRev,fRollGap:c.fRollGap,fMinInt:c.fMinInt});$('status').textContent='Guardando y verificando...';const r=await fetch('/api/config',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:q.toString(),cache:'no-store'});const t=await r.text();if(!r.ok){$('status').textContent='ERROR: '+t;return}const o=JSON.parse(t);if(!o.ok){$('status').textContent='ERROR READ-BACK';return}syncCfg(o.cfg);$('status').textContent='GUARDADO ✓ · NVS verificado';await refresh();}async function loadCurrent(){const r=await fetch('/api/status',{cache:'no-store'}),j=await r.json();syncCfg(j.cfg);lastData=j;drawAll(j);$('status').textContent='Valores actuales cargados';}
async function refresh(){try{const r=await fetch('/api/status',{cache:'no-store'}),j=await r.json();lastData=j;if(first){syncCfg(j.cfg);first=false}$('runPill').textContent=j.running?'DETECCIÓN ACTIVA':'DETENIDA';$('runPill').className='pill '+(j.running?'on':'');$('d1').textContent=j.s1.fresh?j.s1.stable.toFixed(2)+' cm':'--';$('d2').textContent=j.s2.fresh?j.s2.stable.toFixed(2)+' cm':'--';$('yPoint').textContent=j.pair.valid?j.pair.yPoint.toFixed(2)+' cm':'--';$('source').textContent=j.pair.source;$('pointHz').textContent=j.pair.pointHz.toFixed(1);$('jitter').textContent=j.pair.jitter.toFixed(2)+' cm';$('ages').textContent=j.s1.ageMs+' / '+j.s2.ageMs+' ms';$('sensorHz').textContent=j.s1.hz.toFixed(1)+' / '+j.s2.hz.toFixed(1);$('raw').textContent=j.s1.raw.toFixed(1)+' / '+j.s2.raw.toFixed(1)+' cm';$('timeouts').textContent=j.s1.timeouts+' / '+j.s2.timeouts;$('coh').textContent=j.pair.both?j.pair.coherence.toFixed(0)+'%':'1 SENSOR';$('xdiag').textContent=j.pair.geoValid?j.pair.x.toFixed(2)+' cm':'--';$('fY').textContent=j.pair.valid?j.pair.yPoint.toFixed(2)+' cm':'--';$('fV').textContent=j.pair.velocity.toFixed(0)+' cm/s';$('fA').textContent=j.pair.acceleration.toFixed(0)+' cm/s²';$('phase').textContent=j.motion.phase;$('candCount').textContent=j.motion.candidates;$('roll').textContent=j.motion.roll?('ROLL '+j.motion.rollHz.toFixed(1)+' Hz'):'NO';$('scoreText').textContent=j.motion.score.toFixed(0)+'%';$('scoreLabel').textContent=j.motion.score.toFixed(0)+'%';$('scoreBar').style.width=j.motion.score.toFixed(0)+'%';$('lastAmp').textContent=j.motion.lastAmplitude.toFixed(2)+' cm';$('lastSpeed').textContent=j.motion.lastPeakSpeed.toFixed(0)+' cm/s';$('midi').textContent=j.motion.midi;$('period').textContent=j.motion.lastPeriodMs?j.motion.lastPeriodMs.toFixed(0)+' ms':'--';$('rollHz').textContent=j.motion.rollHz?j.motion.rollHz.toFixed(2)+' Hz':'--';$('downInfo').textContent='umbral -'+j.cfg.funcMinDownSpeed.toFixed(0)+' cm/s';$('accInfo').textContent='derivada de V(t)';let ev=false;if(lastEvent===null)lastEvent=j.motion.eventSeq;else if(j.motion.eventSeq!==lastEvent){ev=true;lastEvent=j.motion.eventSeq;playEvent(j.motion.midi||80)}if(j.pair.valid){samples.push({y:j.pair.yPoint,v:j.pair.velocity,a:j.pair.acceleration,event:ev});if(samples.length>260)samples.shift();}drawAll(j);}catch(e){$('status').textContent='Error de comunicación';}}setInterval(refresh,40);refresh();
</script></body></html>
)HTML";
String cfgJson(){String j="{";j+="\"baseline\":"+String(baselineCm,2)+",\"maxRange\":"+String(maxRangeCm,1)+",\"hitPlane\":"+String(hitPlaneCm,1)+",\"coneHalfAngle\":"+String(coneHalfAngleDeg,1)+",";j+="\"targetHz\":"+String(targetHzPerSensor,1)+",\"smoothing\":"+String(smoothingPct,0)+",\"intensityRef\":"+String(intensityRefCmS,1)+",\"rearm\":"+String(rearmMarginCm,1)+",";j+="\"funcMinDownSpeed\":"+String(funcMinDownSpeed,1)+",\"funcMinAmplitude\":"+String(funcMinAmplitude,2)+",\"funcReversalSpeed\":"+String(funcReversalSpeed,1)+",";j+="\"funcMinInterval\":"+String(funcMinIntervalMs)+",\"funcRollMaxGap\":"+String(funcRollMaxGapMs)+",\"slotMs\":"+String(slotMs())+",\"echoTimeoutUs\":"+String(echoTimeoutUs())+"}";return j;}
void sendStatus(){uint32_t now=millis();String j="{";j+="\"fw\":\""+String(FW_VERSION)+"\",\"running\":"+String(acquisitionRunning?"true":"false")+",";for(int i=0;i<2;i++){SensorState&q=s[i];bool fresh=sensorFresh(i,now);uint32_t age=sensorAge(i,now);j+="\"s"+String(i+1)+"\":{";j+="\"ok\":"+String(q.ok?"true":"false")+",\"fresh\":"+String(fresh?"true":"false")+",\"ageMs\":"+String(age)+",";j+="\"raw\":"+String(q.rawCm,2)+",\"fast\":"+String(q.fastCm,2)+",\"stable\":"+String(q.stableCm,2)+",\"velocity\":"+String(q.velocityCmS,2)+",\"jitter\":"+String(q.jitterCm,2)+",";j+="\"timeouts\":"+String(q.timeouts)+",\"rejected\":"+String(q.rejected)+",\"hz\":"+String(q.hz,2)+"}";if(i==0)j+=",";}j+=",\"pair\":{";j+="\"valid\":"+String(pair.valid?"true":"false")+",\"both\":"+String(pair.both?"true":"false")+",\"source\":\""+sourceLabel()+"\",\"yPoint\":"+String(pair.yPoint,2)+",\"yStable\":"+String(pair.yStable,2)+",";j+="\"velocity\":"+String(pair.velocity,2)+",\"acceleration\":"+String(pair.acceleration,2)+",\"geoValid\":"+String(pair.geoValid?"true":"false")+",\"x\":"+String(pair.x,2)+",\"zGeo\":"+String(pair.zGeo,2)+",";j+="\"jitter\":"+String(pair.jitter,2)+",\"coherence\":"+String(pair.coherence,1)+",\"lateral\":\""+pair.lateral+"\",\"pointHz\":"+String(pair.pointHz,2)+"},";j+="\"motion\":{";j+="\"phase\":\""+motion.phase+"\",\"descending\":"+String(motion.descending?"true":"false")+",\"score\":"+String(motion.candidateScore,1)+",\"candidates\":"+String(motion.candidates)+",\"eventSeq\":"+String(motion.eventSeq)+",";j+="\"lastAmplitude\":"+String(motion.lastAmplitude,2)+",\"lastPeakSpeed\":"+String(motion.lastPeakSpeed,1)+",\"lastPeriodMs\":"+String(motion.lastPeriodMs,1)+",\"roll\":"+String(motion.roll?"true":"false")+",\"rollCount\":"+String(motion.rollCount)+",\"rollHz\":"+String(motion.rollHz,2)+",\"energy\":"+String(motion.energy,3)+",\"midi\":"+String(motion.midi)+"},";j+="\"cfg\":"+cfgJson()+"}";server.send(200,"application/json",j);}
void handleConfig(){bool wasRunning=acquisitionRunning;acquisitionRunning=false;if(server.hasArg("base"))baselineCm=clampf(server.arg("base").toFloat(),.5f,10);if(server.hasArg("range"))maxRangeCm=clampf(server.arg("range").toFloat(),20,100);if(server.hasArg("hit"))hitPlaneCm=clampf(server.arg("hit").toFloat(),5,30);if(server.hasArg("angle"))coneHalfAngleDeg=clampf(server.arg("angle").toFloat(),3,20);if(server.hasArg("rate"))targetHzPerSensor=clampf(server.arg("rate").toFloat(),5,16);if(server.hasArg("smooth"))smoothingPct=clampf(server.arg("smooth").toFloat(),0,100);if(server.hasArg("speed"))intensityRefCmS=clampf(server.arg("speed").toFloat(),10,180);if(server.hasArg("fSpeed"))funcMinDownSpeed=clampf(server.arg("fSpeed").toFloat(),10,250);if(server.hasArg("fAmp"))funcMinAmplitude=clampf(server.arg("fAmp").toFloat(),.4f,10);if(server.hasArg("fRev"))funcReversalSpeed=clampf(server.arg("fRev").toFloat(),1,60);if(server.hasArg("fRollGap"))funcRollMaxGapMs=clampu(server.arg("fRollGap").toInt(),120,900);if(server.hasArg("fMinInt"))funcMinIntervalMs=clampu(server.arg("fMinInt").toInt(),40,300);String detail;bool ok=saveAndVerifyConfig(detail);resetTracking(true);nextSensor=0;nextMeasureMs=millis()+80;acquisitionRunning=wasRunning;String out="{\"ok\":"+String(ok?"true":"false")+",\"detail\":\""+detail+"\",\"cfg\":"+cfgJson()+"}";server.send(ok?200:500,"application/json",out);}
void handleRun(){if(server.hasArg("on"))acquisitionRunning=server.arg("on")!="0";if(acquisitionRunning){resetTracking(true);nextSensor=0;nextMeasureMs=millis()+80;}server.send(200,"text/plain","OK");}
void setup(){Serial.begin(115200);delay(120);loadConfig();resetMotion();for(int i=0;i<2;i++){pinMode(PINS[i].echo,INPUT);pinMode(PINS[i].trig,OUTPUT);digitalWrite(PINS[i].trig,LOW);}WiFi.mode(WIFI_AP);WiFi.softAP(AP_SSID);server.on("/",[](){server.send_P(200,"text/html",PAGE);});server.on("/api/status",HTTP_GET,sendStatus);server.on("/api/config",HTTP_POST,handleConfig);server.on("/api/run",HTTP_GET,handleRun);server.on("/api/reset",HTTP_GET,[](){resetMotion();server.send(200,"text/plain","OK");});server.begin();nextMeasureMs=millis()+300;}
void loop(){server.handleClient();serviceSensors();delay(1);}
